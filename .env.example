# Copy to .env (gitignored) and fill in what you need. Every value has a working
# default in src/nl2sql/config.py; with no key at all, use NL2SQL_LLM_PROVIDER=stub.

# Which model writes the SQL: gemini | openai | anthropic | ollama | stub (offline, no key)
NL2SQL_LLM_PROVIDER=gemini

# >>> Put your key here. Gemini keys are free: https://aistudio.google.com/apikey
NL2SQL_GEMINI_API_KEY=
NL2SQL_OPENAI_API_KEY=
NL2SQL_ANTHROPIC_API_KEY=

# Blank = provider default (gemini-2.5-flash, gpt-4o-mini, claude-sonnet-5, qwen2.5-coder:7b)
NL2SQL_LLM_MODEL=
NL2SQL_OLLAMA_BASE_URL=http://localhost:11434

# Safety limits: the LIMIT injected into every query, the per-query timeout,
# and how many times the model may fix its own failed query (0 = never).
NL2SQL_MAX_RESULT_ROWS=1000
NL2SQL_QUERY_TIMEOUT_SECONDS=30
NL2SQL_MAX_REPAIR_ATTEMPTS=2

# Retrieval: false sends the whole schema / uses the NumPy embedding fallback.
NL2SQL_RETRIEVAL_ENABLED=true
NL2SQL_EMBEDDINGS_ENABLED=true

# The SQLite warehouse, relative to the project root.
NL2SQL_DB_PATH=data/db/bank.sqlite

# text | json
NL2SQL_LOG_FORMAT=text
NL2SQL_LOG_LEVEL=INFO
